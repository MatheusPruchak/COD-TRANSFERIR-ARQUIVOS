
CARREGAR CARTÃO PONTO AUTOMATICO

$origem = "C:\Users\Oem\Desktop\TESTE CARREGAR SERVIDOR AUTOMATICO"
$destinoBase = "S:\RH\COFRE SERVSUL"

$anoAtual = (Get-Date).Year

Get-ChildItem -Path $origem -File | ForEach-Object {

    $arquivo = $_.Name
    Write-Host "`n📄 Processando:" $arquivo

    # ===== MATRÍCULA NO FINAL =====
    if ($arquivo -match "(\d+)(?=\D*$)") {

        $matricula = $matches[1]
        Write-Host "🔎 Matrícula:" $matricula

        # ===== BUSCA PASTA FUNCIONÁRIO =====
        $pastaMatricula = Get-ChildItem -Path $destinoBase -Directory |
            Where-Object { $_.Name -match "^$matricula\b" } |
            Select-Object -First 1

        # ===== NOVA BUSCA EM NOVAS ADMISSÕES =====
        if (-not $pastaMatricula) {

            Write-Host "🔎 Procurando em NOVAS ADMISSÕES..."

            $pastaMatricula = Get-ChildItem -Path "S:\RH\NOVAS ADMISSÕES" -Directory |
                Where-Object { $_.Name -match "^$matricula\b" } |
                Select-Object -First 1
        }

        if ($pastaMatricula) {

            Write-Host "📁 Pasta encontrada:" $pastaMatricula.FullName

            # ===== PROCURA PASTA BASE (MAIS FLEXÍVEL) =====
            $pastaBase = Get-ChildItem -Path $pastaMatricula.FullName -Directory |
                Where-Object {
                    $_.Name -match "(?i)cart[aã]o[\s_-]?ponto" -or
                    $_.Name -match "(?i)^ponto(s)?$" -or
                    $_.Name -match "(?i)ponto eletr[oô]nico"
                } |
                Select-Object -First 1

            if (-not $pastaBase) {

                Write-Host "⚠ Criando pasta base CARTAO_PONTO..."
                $pastaBase = New-Item -ItemType Directory -Path (Join-Path $pastaMatricula.FullName "CARTAO_PONTO") -Force
            }

            Write-Host "📂 Pasta base:" $pastaBase.FullName

            # ===== ANO DINÂMICO =====
            $pastaAno = Join-Path $pastaBase.FullName $anoAtual

            if (-not (Test-Path $pastaAno)) {
                Write-Host "⚠ Criando pasta $anoAtual..."
                New-Item -ItemType Directory -Path $pastaAno -Force | Out-Null
            }

            # ===== EVITA SOBRESCREVER =====
            $destinoFinal = Join-Path $pastaAno $arquivo

            if (Test-Path $destinoFinal) {
                $novoNome = "{0}_{1}{2}" -f $_.BaseName, (Get-Date -Format "HHmmss"), $_.Extension
                $destinoFinal = Join-Path $pastaAno $novoNome
                Write-Host "⚠ Arquivo já existe, renomeado para:" $novoNome
            }

            # ===== MOVE COM TRY/CATCH =====
            try {
                Move-Item $_.FullName $destinoFinal -ErrorAction Stop
                Write-Host "✅ MOVIDO COM SUCESSO!"
            }
            catch {
                Write-Host "❌ Erro ao mover:" $_
            }
        }
        else {
            Write-Host "❌ Pasta da matrícula não encontrada (nem no COFRE nem em NOVAS ADMISSÕES)"
        }
    }
    else {
        Write-Host "❌ Não conseguiu extrair matrícula"
    }
}





